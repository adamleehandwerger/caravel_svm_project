{
    "DESIGN_NAME": "svm_compute_core",
    "VERILOG_FILES": [
        "dir::../../verilog/rtl/svm_compute_core.sv",
        "dir::../../verilog/rtl/svm_fifo_sram.sv"
    ],
    "CLOCK_PORT": "clk",
    "CLOCK_NET": "clk",
    "pdk::sky130*": {
        "CLOCK_PERIOD": 40,
        "scl::sky130_fd_sc_hd": {
            "CLOCK_PERIOD": 40
        }
    },
    "PDK": "sky130A",
    "STD_CELL_LIBRARY": "sky130_fd_sc_hd",

    "FP_SIZING": "absolute",
    "DIE_AREA": "0 0 2000 1000",
    "PL_TARGET_DENSITY": 0.45,

    "SYNTH_STRATEGY": "AREA 0",
    "SYNTH_SIZING": 1,
    "MAX_FANOUT_CONSTRAINT": 8,

    "DIODE_INSERTION_STRATEGY": 3,
    "QUIT_ON_TIMING_VIOLATIONS": false,
    "QUIT_ON_HOLD_VIOLATIONS": false,
    "RUN_CVC": 0,

    "VERILOG_FILES_BLACKBOX": [
        "dir::../../verilog/rtl/sim_sram_models.sv"
    ],
    "EXTRA_LEFS": [
        "$PDK_ROOT/sky130A/libs.ref/sky130_sram_macros/lef/sky130_sram_8kbyte_1rw1r_32x2048_8.lef"
    ],
    "EXTRA_GDS_FILES": [
        "$PDK_ROOT/sky130A/libs.ref/sky130_sram_macros/gds/sky130_sram_8kbyte_1rw1r_32x2048_8.gds"
    ],
    "EXTRA_LIBS": [
        "$PDK_ROOT/sky130A/libs.ref/sky130_sram_macros/lib/sky130_sram_8kbyte_1rw1r_32x2048_8_TT_1p8V_25C.lib"
    ],
    "MACRO_PLACEMENT_CFG": "dir::macro.cfg",
    "FP_PDN_MACRO_HOOKS": [
        "u_input_fifo.macro0 vccd1 vssd1 vccd1 vssd1",
        "u_input_fifo.macro1 vccd1 vssd1 vccd1 vssd1"
    ],
    "RT_MAX_LAYER": "met4",
    "RUN_KLAYOUT_DRC": false,
    "RUN_LINTER": 0,
    "QUIT_ON_SYNTH_CHECKS": 0
}
